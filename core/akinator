from __future__ import annotations
from dataclasses import dataclass, field
import numpy as np
from core.ranking import ProgramScore
from embeddings.vector_store import IndexSnapshot
from embeddings.embedder import embed_text

@dataclass
class Question:
    text: str
    detail: str | None
    rationale: str | None
    probe_text: str
    source: str

@dataclass
class Turn:
    question: Question
    answer: str

@dataclass
class Explanation:
    name: str
    percent_label: str
    cosine: float
    low_match: bool
    text: str
    pro: list[str]
    contra: list[str]
    modules: list[tuple[str, str]]

@dataclass
class AkinatorSession:
    snapshot: IndexSnapshot
    user_vector: np.ndarray = field(default_factory=lambda: np.zeros(0))
    turns: list[Turn] = field(default_factory=list)
    question: Question | None = None

    @classmethod
    def create(cls, snapshot: IndexSnapshot) -> AkinatorSession:
        return cls(snapshot=snapshot, user_vector=snapshot.prior.copy())

    def compute_scores(self) -> list[ProgramScore]:
        if len(self.user_vector) == 0:
            vec = self.snapshot.prior
        else:
            vec = self.user_vector
            norm = np.linalg.norm(vec)
            if norm > 1e-12:
                vec = vec / norm
        
        sims = self.snapshot.centroids @ vec
        scores = []
        for pid, name, sim in zip(self.snapshot.program_ids, self.snapshot.program_names, sims):
            # Lineare Skalierung (z.B. 0.4 bis 0.75 auf 0 bis 100%)
            pct = float(np.clip((sim - 0.4) / (0.75 - 0.4) * 100, 0, 100))
            scores.append(ProgramScore(
                program_id=pid,
                name=name,
                cosine=float(sim),
                percent=pct,
                below_floor=sim < 0.4
            ))
        scores.sort(key=lambda s: s.percent, reverse=True)
        return scores

    @property
    def scores(self) -> list[ProgramScore]:
        return self.compute_scores()

    def start(self, intro: str) -> None:
        if intro.strip():
            v = embed_text(intro)
            self.user_vector = 0.7 * self.snapshot.prior + 0.3 * v
        else:
            self.user_vector = self.snapshot.prior.copy()
        
        self.next_question()

    def answer(self, label: str) -> None:
        if not self.question:
            return
        self.turns.append(Turn(question=self.question, answer=label))
        
        # Verschiebt den Vektor im Embedding-Raum basierend auf der Nutzerantwort
        probe_v = embed_text(self.question.probe_text)
        weight = {"Ja": 0.35, "Teilweise": 0.15, "Nein": -0.2}.get(label, 0.1)
        self.user_vector = self.user_vector + weight * probe_v
        
        norm = np.linalg.norm(self.user_vector)
        if norm > 1e-12:
            self.user_vector /= norm

        if len(self.turns) >= 6:
            self.question = None
        else:
            self.next_question()

    def next_question(self) -> None:
        # Dynamische Auswahl basierend auf dem aktuellen Top-Studiengang und den noch unentdeckten Chunks
        current_scores = self.scores
        top_prog = current_scores[0].program_id
        prog_idx = self.snapshot.program_ids.index(top_prog)
        chunk_indices = self.snapshot.chunks_of(prog_idx)
        
        if len(chunk_indices) > 0:
            idx = int(np.random.choice(chunk_indices))
            chunk = self.snapshot.chunk_texts[idx]
            meta = self.snapshot.chunk_meta[idx]
            mod_name = meta.get("module", "Modul")
            
            self.question = Question(
                text=f"Wie bewertest du dein Interesse an Inhalten wie: „{mod_name}“?",
                detail=chunk[:280] + "..." if len(chunk) > 280 else chunk,
                rationale=f"Dieser Auszug stammt direkt aus dem Modulhandbuch von {current_scores[0].name} und grenzt deine Interessen ein.",
                probe_text=chunk,
                source="Modulhandbuch-Analyse"
            )
        else:
            self.question = Question(
                text="Interessierst du dich für praktische Projektarbeiten in interdisziplinären Teams?",
                detail="Einblicke in praxisnahe Projektmodule.",
                rationale="Projektarbeit ist ein zentrales Element.",
                probe_text="Projektarbeit Praxis Teamwork",
                source="Standard-Probe"
            )

    def explanations(self) -> list[Explanation]:
        scores = self.scores
        exs = []
        for s in scores[:3]:
            exs.append(Explanation(
                name=s.name,
                percent_label=f"{s.percent:.1f}%",
                cosine=s.cosine,
                low_match=s.below_floor,
                text=f"Der Studiengang {s.name} erreicht eine Ähnlichkeit von {s.cosine:.2f} im Vektorraum.",
                pro=["Hohe Passung mit deinen angegebenen Schwerpunkten."],
                contra=["Einige Vertiefungen liegen weiter von deinen Antworten entfernt."] if s.below_floor else [],
                modules=[("Modulbeispiel", "Auszug aus dem Modulhandbuch.")]
            ))
        return exs

    def continue_asking(self) -> None:
        self.turns = []
        self.next_question()